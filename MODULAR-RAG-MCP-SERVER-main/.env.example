# Copy to .env on the cloud server (never commit real secrets).
#   cp .env.example .env

# OpenAI-compatible providers (OpenAI / DeepSeek via OpenAI SDK)
OPENAI_API_KEY=

# Azure OpenAI (only if provider is azure in config/settings.yaml)
AZURE_OPENAI_API_KEY=

# Host port mapped to Streamlit inside the container
DASHBOARD_PORT=8501
