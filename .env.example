# Copy to .env on the cloud server (never commit real secrets).
#   cp .env.example .env

# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jchatmind

# ---- Published ports ----
AGENT_PORT=8080
DASHBOARD_PORT=8501

# ---- Agent / LLM ----
JCHATMIND_RAG_PROVIDER=mcp
JCHATMIND_MCP_DEFAULT_COLLECTION=default
# 可选：kb UUID -> collection JSON
# JCHATMIND_MCP_KB_COLLECTION_MAP={"uuid-here":"default"}

JCHATMIND_QWEN_API_KEY=
JCHATMIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JCHATMIND_ZHIPU_API_KEY=
JCHATMIND_DEEPSEEK_API_KEY=

# 外界嵌入（可选；MCP 检索主路径不依赖本地 embed）
JCHATMIND_EMBED_BACKEND=openai
JCHATMIND_EMBED_API_KEY=
JCHATMIND_EMBED_BASE_URL=
JCHATMIND_EMBED_MODEL=text-embedding-v3

# ---- Modular RAG (Dashboard + MCP child) ----
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
